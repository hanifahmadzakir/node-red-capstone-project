    {
        "id": "05cba78303d3c032",
        "type": "function",
        "z": "726aeb7220087d28",
        "name": "Build MID 0001 (Connect)",
        "func": "// MID 0001 (Communication Start) - Length 20 bytes\nconst MID_STRING = '00200001001000000000';\nconst NUL_BYTE = Buffer.from([0x00]);\n\n// Create a Buffer to ensure correct byte encoding\nlet buffer = Buffer.from(MID_STRING, 'ascii');\nmsg.payload = Buffer.concat([buffer, NUL_BYTE]);\n\nglobal.set('connectMID1', msg.payload)\n\nreturn msg;",

    {
        "id": "226ff07f2d1ecb70",
        "type": "function",
        "z": "726aeb7220087d28",
        "name": "Parsing ASCII to JSON",
        "func": "var output = msg.payload.toString(); // konversi Buffer ke string\nvar finalData = {};\n\nif (output.length <= 197) {\n    finalData = {\n        \"length\": output.slice(0, 4),\n        \"mid\": output.slice(4, 8),\n        \"revision\": output.slice(8, 11),\n        \"No ACK Flag\": output.slice(11, 20),\n        \"Data\": [\n            { \"name\": \"Cell ID\", \"value\": output.slice(22, 26) },\n            { \"name\": \"Channel ID\", \"value\": output.slice(28, 30) },\n            { \"name\": \"Controller Name\", \"value\": output.slice(32, 47) },\n            { \"name\": \"ID Code\", \"value\": \"-\" },\n            { \"name\": \"Job Number\", \"value\": output.slice(51, 53) },\n            { \"name\": \"Program Number\", \"value\": output.slice(55, 58) },\n            { \"name\": \"OK Limit\", \"value\": output.slice(60, 64) },\n            { \"name\": \"OK Value\", \"value\": output.slice(66, 70) },\n            { \"name\": \"Tightening Status\", \"value\": output.slice(72, 73) },\n            { \"name\": \"Torque Status\", \"value\": output.slice(75, 76) },\n            { \"name\": \"Angle Status\", \"value\": output.slice(78, 79) },\n            { \"name\": \"Min Torque\", \"value\": output.slice(81, 87) },\n            { \"name\": \"Max Torque\", \"value\": output.slice(89, 95) },\n            { \"name\": \"Target Torque\", \"value\": output.slice(97, 103) },\n            { \"name\": \"Actual Torque\", \"value\": output.slice(105, 111) },\n            { \"name\": \"Min Angle\", \"value\": output.slice(113, 118) },\n            { \"name\": \"Max Angle\", \"value\": output.slice(120, 125) },\n            { \"name\": \"Target Angle\", \"value\": output.slice(127, 132) },\n            { \"name\": \"Actual Angle\", \"value\": output.slice(134, 139) },\n            { \"name\": \"Timestamp\", \"value\": output.slice(141, 160) },\n            { \"name\": \"Last Change\", \"value\": output.slice(162, 181) },\n            { \"name\": \"Counter Status\", \"value\": output.slice(183, 184) },\n            { \"name\": \"Tightening ID\", \"value\": output.slice(186, 196) }\n        ]\n    };\n} else if (output.length >= 206) {\n    finalData = {\n        \"length\": output.slice(0, 4),\n        \"mid\": output.slice(4, 8),\n        \"revision\": output.slice(8, 11),\n        \"No ACK Flag\": output.slice(11, 20),\n        \"Data\": [\n            { \"name\": \"Cell ID\", \"value\": output.slice(22, 26) },\n            { \"name\": \"Channel ID\", \"value\": output.slice(28, 30) },\n            { \"name\": \"Controller Name\", \"value\": output.slice(32, 47) },\n            { \"name\": \"ID Code\", \"value\": output.slice(49, 58) },\n            { \"name\": \"Job Number\", \"value\": output.slice(60, 62) },\n            { \"name\": \"Program Number\", \"value\": output.slice(64, 67) },\n            { \"name\": \"OK Limit\", \"value\": output.slice(69, 73) },\n            { \"name\": \"OK Value\", \"value\": output.slice(75, 79) },\n            { \"name\": \"Tightening Status\", \"value\": output.slice(81, 82) },\n            { \"name\": \"Torque Status\", \"value\": output.slice(84, 85) },\n            { \"name\": \"Angle Status\", \"value\": output.slice(87, 88) },\n            { \"name\": \"Min Torque\", \"value\": output.slice(90, 96) },\n            { \"name\": \"Max Torque\", \"value\": output.slice(98, 104) },\n            { \"name\": \"Target Torque\", \"value\": output.slice(106, 112) },\n            { \"name\": \"Actual Torque\", \"value\": output.slice(114, 120) },\n            { \"name\": \"Min Angle\", \"value\": output.slice(122, 127) },\n            { \"name\": \"Max Angle\", \"value\": output.slice(129, 134) },\n            { \"name\": \"Target Angle\", \"value\": output.slice(136, 141) },\n            { \"name\": \"Actual Angle\", \"value\": output.slice(143, 148) },\n            { \"name\": \"Timestamp\", \"value\": output.slice(150, 169) },\n            { \"name\": \"Last Change\", \"value\": output.slice(171, 190) },\n            { \"name\": \"Counter Status\", \"value\": output.slice(192, 193) },\n            { \"name\": \"Tightening ID\", \"value\": output.slice(195, 205) }\n        ]\n    };\n} else {\n    finalData = { \"error\": \"Unexpected string length: \" + output.length };\n}\n\nflow.set('latestData', finalData)\n\nvar id = finalData.Data[3].value;\nvar program = finalData.Data[5].value;\nvar result = (finalData.Data[8].value === \"1\") ? \"OK\" : \"NOK\";\nvar finalTorque = Number(finalData.Data[14].value) / 100;\nvar finalAngle = Number(finalData.Data[18].value);\nvar timestamp = finalData.Data[19].value;\n\nif (finalData.mid === \"0061\") {\n    global.set('id', id);\n    global.set('program', program);\n    global.set('result', result);\n    global.set('finalTorque', finalTorque);\n    global.set('finalAngle', finalAngle);\n    global.set('timestamp', timestamp);\n} else {\n    return null\n}\n\n\nmsg.payload = finalData;\nreturn msg;\n",

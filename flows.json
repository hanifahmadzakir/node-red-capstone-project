    {
        "id": "get_all_from_memory",
        "type": "function",
        "z": "fb6f18224a2564ed",
        "name": "Retrieve from memory",
        "func": "let latestData = flow.get(\"latestTelemetry\") || {\n    \"temperature\": 0,\n    \"humidity\": 0,\n    \"light_intensity\": 0,\n    \"soil_moisture\": 0,\n    \"status\": \"waiting for device...\"\n};\n\nmsg.payload = {\n    status: \"success\",\n    data: latestData\n};\nmsg.statusCode = 200;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,

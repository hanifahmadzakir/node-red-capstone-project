        "func": "if (msg.payload.mid === \"0061\") {\n    // MID 0001 (Communication Start) - Length 20 bytes\n    const MID_STRING = '00200062001000000000';\n    const NUL_BYTE = Buffer.from([0x00]);\n\n    // Create a Buffer to ensure correct byte encoding\n    let buffer = Buffer.from(MID_STRING, 'ascii');\n    msg.payload = Buffer.concat([buffer, NUL_BYTE]);\n    msg.action = \"write\";\n    msg.port = \"4545\";\n    msg.host = \"192.168.0.23\"\n} else {\n    return null\n}\n\nreturn msg;",

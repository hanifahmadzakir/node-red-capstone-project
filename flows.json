        "func": "function getRandom(min, max) {\n    return Math.random() * (max - min) + min;\n}\n\nmsg.payload = {\n    \"temperature\": parseFloat(getRandom(25.0, 35.0).toFixed(1)), // Suhu 25-35 C\n    \"humidity\": parseFloat(getRandom(50.0, 85.0).toFixed(1)),    // Kelembapan 50-85%\n    \"light_intensity\": Math.floor(getRandom(8000, 15000)),       // Cahaya 8000-15000 Lux\n    \"soil_moisture\": Math.floor(getRandom(30, 80))               // Tanah 30-80%\n};\n\nreturn msg;",

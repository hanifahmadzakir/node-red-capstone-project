    {
        "id": "rules_engine",
        "type": "function",
        "z": "8d6b6dfcf3939a8a",
        "g": "group_sensor",
        "name": "Evaluasi (Sensor + API)",
        "func": "let sensor = msg.payload;\nlet kelembaban = sensor.soil_moisture;\n\nlet prob_hujan = global.get('probabilitas_hujan') || 0;\n\n// ==========================================\n// PENGAMBILAN KEPUTUSAN\n// ==========================================\n\nif (kelembaban >= 70) {\n    // KONDISI 1: Tanah Basah (Aman)\n    msg.payload = \"OFF\";\n    \n} else if (kelembaban < 40 && prob_hujan < 50) {\n    // KONDISI 2: Tanah Kering & Cuaca Cerah\n    msg.payload = \"ON\";\n    \n} else if (kelembaban < 40 && prob_hujan >= 50) {\n    // KONDISI 3: Tanah Kering TAPI Akan Hujan!\n    // Tahan pompa untuk hemat energi\n    msg.payload = \"OFF\";\n    \n} else {\n    // Kondisi netral (di antara 40-70%), tidak mengubah status pompa\n    return null; \n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 1280,
        "wires": [
            [
                "debug_pompa"
            ]
        ]
    },

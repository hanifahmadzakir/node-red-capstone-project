        "type": "function",
        "z": "fb6f18224a2564ed",
        "name": "check if message is JSON",
        "func": "if(typeof msg.payload === 'string') {\n    try {\n        msg.payload = JSON.parse(msg.payload);\n    } catch (error) {\n        // If parsing fails, send a 400 Bad Request error back\n        msg.statusCode = 400;\n        msg.payload = { status: \"error\", message: \"Invalid JSON format\" };\n        return msg;\n    }\n}\n\nmsg.statusCode = 200;\nreturn msg;",
